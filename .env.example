# Upstream REST API (server-side only — proxied through /api/v1/*)
BACKPACK_API_URL=https://api.backpack.exchange

# Coin metadata / price index (server-side only — proxied through /api/v1/coins)
PRICE_INDEXER_API_URL=https://price-indexer.workers.madlads.com

# WebSocket endpoint. Public: the browser opens this socket directly.
NEXT_PUBLIC_BACKPACK_WS_URL=wss://ws.backpack.exchange/
